#!/usr/bin/env bash
# Installs GoGame on a fresh Ubuntu 24.04 server (x86_64), such as an AWS EC2 instance.
# See deploy/aws/README.md. Clone the project into /opt/gogame first, then:
#
#   sudo /opt/gogame/bin/install-server go.example.com --email you@example.com
#
# It installs Java, sbt, Node.js, MongoDB, Redis, nginx and certbot; builds lila and lila-ws;
# installs KataGo; writes the production config with new secrets (bin/setup-production);
# protects MongoDB and Redis with the generated passwords; installs the gogame and gogame-ws
# services, the nginx site, HTTPS (with --email, once DNS points here), the firewall and a
# daily database backup.
#
# Run it again after a git pull to rebuild and restart: existing secrets are kept.
#
#   --email ADDRESS     for Let's Encrypt (expiry notices). Without it, HTTPS is left to you.
#   --ws-domain NAME    the websocket domain (default: ws.DOMAIN)
#   --user NAME         the system user that runs GoGame (default: gogame)
set -euo pipefail

say() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

domain=""
email=""
ws_domain=""
user="gogame"
while [ $# -gt 0 ]; do
  case "$1" in
    --email) email="$2"; shift 2 ;;
    --ws-domain) ws_domain="$2"; shift 2 ;;
    --user) user="$2"; shift 2 ;;
    -*) die "unknown option $1" ;;
    *) domain="$1"; shift ;;
  esac
done
[ -n "$domain" ] || die "usage: sudo bin/install-server DOMAIN [--email ADDRESS] [--ws-domain NAME]"
ws_domain="${ws_domain:-ws.$domain}"
# lila's login cookie is set for $domain and its subdomains: lila-ws only gets it there
case "$ws_domain" in
  *".$domain") ;;
  *) die "the websocket domain must be a subdomain of $domain (e.g. ws.$domain), or the login cookie doesn't reach it" ;;
esac

[ "$(id -u)" = 0 ] || die "run it with sudo"
. /etc/os-release
[ "${ID:-}" = ubuntu ] && [ "${VERSION_ID:-}" = 24.04 ] || die "this script is for Ubuntu 24.04 (found ${PRETTY_NAME:-unknown})"
[ "$(uname -m)" = x86_64 ] || die "x86_64 only: KataGo's Linux release is built for x86_64 (on AWS, pick an Intel or AMD instance)"

dir="$(cd "$(dirname "$0")/.." && pwd)"
[ -f "$dir/build.sbt" ] && [ -d "$dir/modules/goban" ] || die "run the copy of the script inside the GoGame folder"
case "$dir" in /root/* | /home/*) die "move the project out of a home folder, e.g. to /opt/gogame (the $user user must own it)" ;; esac
export DEBIAN_FRONTEND=noninteractive

as_user() { sudo -u "$user" -H bash -c "cd '$dir' && $*"; }

say "System packages"
apt-get update -qq
apt-get install -y -qq ca-certificates curl gnupg git unzip openssl binutils ufw \
  openjdk-21-jdk-headless redis-server nginx python3-certbot-nginx >/dev/null

if [ ! -f /etc/apt/sources.list.d/mongodb-org-8.0.list ]; then
  say "MongoDB 8.0 repository"
  curl -fsSL https://pgp.mongodb.com/server-8.0.asc | gpg --dearmor --yes -o /usr/share/keyrings/mongodb-server-8.0.gpg
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
    >/etc/apt/sources.list.d/mongodb-org-8.0.list
fi
if [ ! -f /etc/apt/sources.list.d/sbt.list ]; then
  say "sbt repository"
  curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" |
    gpg --dearmor --yes -o /usr/share/keyrings/sbt.gpg
  echo "deb [signed-by=/usr/share/keyrings/sbt.gpg] https://repo.scala-sbt.org/scalasbt/debian all main" \
    >/etc/apt/sources.list.d/sbt.list
fi
if ! node -e 'process.exit(+process.versions.node.split(".")[0] >= 24 ? 0 : 1)' 2>/dev/null; then
  say "Node.js 24"
  curl -fsSL https://deb.nodesource.com/setup_24.x | bash - >/dev/null
fi
apt-get update -qq
apt-get install -y -qq mongodb-org sbt nodejs >/dev/null
command -v pnpm >/dev/null || npm install -g --silent pnpm@12
systemctl enable --now mongod redis-server >/dev/null 2>&1

# building lila needs about 8 GB of memory (.sbtopts): add swap on smaller machines
mem_gb=$(awk '/MemTotal/ {print int($2 / 1024 / 1024)}' /proc/meminfo)
if [ "$mem_gb" -lt 15 ] && ! swapon --show | grep -q .; then
  say "Adding 8 GB of swap (this machine has ${mem_gb} GB of memory)"
  fallocate -l 8G /swapfile && chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi

if ! id "$user" >/dev/null 2>&1; then
  say "Creating the $user user"
  useradd --system --create-home --shell /bin/bash "$user"
fi
chown -R "$user:$user" "$dir"
sudo -u "$user" git config --global --add safe.directory "$dir" 2>/dev/null || true

say "Building the front end"
as_user ./ui/build
# sbt 2 builds in a server it starts in the background, which keeps running afterwards
# (lila's takes up to 8 GB): shut it down after the build, and also when the build fails
build() { # folder, sbt runner
  if ! as_user "cd $1 && $2 'stage; shutdown' </dev/null"; then
    as_user "cd $1 && sbt shutdown </dev/null" >/dev/null 2>&1 || true
    die "the build in $1 failed"
  fi
}
say "Building lila"
build . ./lila.sh
say "Building lila-ws"
build ws sbt
say "KataGo"
as_user bin/setup-katago

# new secrets on a first install; with a conf/secrets.conf already there (a rerun, or one
# brought from another server), it is kept and the files derived from it are rebuilt
say "Production configuration"
as_user bin/setup-production "$domain" "$ws_domain"
mongo_password=$(grep -oE 'mongodb://gogame:[0-9a-f]+@' "$dir/conf/secrets.conf" | head -1 | sed -E 's/.*gogame:([0-9a-f]+)@/\1/')
redis_password=$(grep -oE 'redis://:[0-9a-f]+@' "$dir/conf/secrets.conf" | head -1 | sed -E 's/redis:\/\/:([0-9a-f]+)@/\1/')
[ -n "$mongo_password" ] && [ -n "$redis_password" ] || die "could not read the passwords from conf/secrets.conf"

app_uri="mongodb://gogame:$mongo_password@127.0.0.1:27017/gogame?authSource=admin"
wait_primary() { # mongosh arguments: wait until this MongoDB accepts writes
  for _ in $(seq 60); do
    [ "$(mongosh --quiet "$@" --eval 'db.hello().isWritablePrimary' 2>/dev/null)" = true ] && return 0
    sleep 1
  done
  die "MongoDB did not start (journalctl -u mongod)"
}

# MongoDB's cache defaults to half the memory: 4 GB leaves room for lila, lila-ws and KataGo.
# Added inside the existing storage: block (the other storage settings stay), only once.
if ! grep -qE '^[[:space:]]*cacheSizeGB:' /etc/mongod.conf; then
  if grep -qE '^[[:space:]]+wiredTiger:' /etc/mongod.conf; then
    say "MongoDB: /etc/mongod.conf has its own wiredTiger settings: add cacheSizeGB: 4 under engineConfig yourself"
  else
    say "MongoDB: cache limited to 4 GB"
    if grep -q '^storage:' /etc/mongod.conf; then
      awk '{ print } /^storage:/ && !done { print "  wiredTiger:\n    engineConfig:\n      cacheSizeGB: 4"; done = 1 }' \
        /etc/mongod.conf >/etc/mongod.conf.new
      cat /etc/mongod.conf.new >/etc/mongod.conf && rm /etc/mongod.conf.new
    else
      printf '\nstorage:\n  wiredTiger:\n    engineConfig:\n      cacheSizeGB: 4\n' >>/etc/mongod.conf
    fi
    systemctl restart mongod
  fi
fi

say "MongoDB: a one-member replica set, with passwords"
# A replica set, even of one member, lets backups take a consistent snapshot (mongodump --oplog)
if ! grep -q '^replication:' /etc/mongod.conf; then
  grep -q '^security:' /etc/mongod.conf &&
    die "MongoDB already has passwords but no replica set (an older install): see deploy/aws/README.md, Updating"
  printf '\nreplication:\n  replSetName: rs0\n' >>/etc/mongod.conf
  systemctl restart mongod
  for _ in $(seq 60); do mongosh --quiet --eval 'db.runCommand({ping: 1}).ok' >/dev/null 2>&1 && break; sleep 1; done
  mongosh --quiet --eval 'rs.initiate({_id: "rs0", members: [{_id: 0, host: "127.0.0.1:27017"}]})' >/dev/null
fi
install -d -m 750 -o "$user" -g "$user" /etc/gogame
if ! grep -q '^security:' /etc/mongod.conf; then
  wait_primary
  backup_password=$(openssl rand -hex 24)
  mongosh --quiet admin --eval "
    if (!db.getUser('gogame')) db.createUser({user: 'gogame', pwd: '$mongo_password', roles: [{role: 'readWrite', db: 'gogame'}]});
    if (!db.getUser('gogame-backup')) db.createUser({user: 'gogame-backup', pwd: '$backup_password', roles: ['backup', 'restore']});" >/dev/null
  # the backup user's credentials, for bin/backup-database and bin/restore-database
  (umask 077 && printf 'uri: "mongodb://gogame-backup:%s@127.0.0.1:27017/?authSource=admin"\n' "$backup_password" >/etc/gogame/mongodump.yaml)
  chown "$user:$user" /etc/gogame/mongodump.yaml
  # replica set members authenticate each other with a key file, required with passwords on
  openssl rand -base64 756 >/etc/mongod.key
  chown mongodb:mongodb /etc/mongod.key && chmod 400 /etc/mongod.key
  printf '\nsecurity:\n  authorization: enabled\n  keyFile: /etc/mongod.key\n' >>/etc/mongod.conf
  systemctl restart mongod
fi
wait_primary "$app_uri"

say "Database indexes (unique emails, expiring sessions and tokens...)"
mongosh --quiet "$app_uri" "$dir/bin/mongodb/indexes-gogame.js"

say "Redis password"
sed -i '/^requirepass /d' /etc/redis/redis.conf
echo "requirepass $redis_password" >>/etc/redis/redis.conf
systemctl restart redis-server

say "Services"
# the services see the project folder read-only (see deploy/systemd): give them the folders
# they write to
install -d -m 750 -o "$user" -g "$user" /var/backups/gogame
install -d -o "$user" -g "$user" "$dir/katago/gtp_logs"
heap=2g
[ "$mem_gb" -ge 15 ] && heap=4g
for unit in gogame gogame-ws gogame-backup; do
  for kind in service timer; do
    src="$dir/deploy/systemd/$unit.$kind"
    [ -f "$src" ] || continue
    sed -e "s|@DIR@|$dir|g; s|@USER@|$user|g; s|@HEAP@|$heap|g" "$src" >"/etc/systemd/system/$unit.$kind"
  done
done
systemctl daemon-reload
systemctl enable gogame gogame-ws gogame-backup.timer >/dev/null 2>&1
systemctl restart gogame gogame-ws
systemctl start gogame-backup.timer

say "nginx"
# keep the site once certbot has added HTTPS to it (on a rerun, for an update)
if ! grep -q "managed by Certbot" /etc/nginx/sites-available/gogame 2>/dev/null; then
  install -m 644 "$dir/conf/nginx-gogame.conf" /etc/nginx/sites-available/gogame
fi
ln -sf /etc/nginx/sites-available/gogame /etc/nginx/sites-enabled/gogame
rm -f /etc/nginx/sites-enabled/default

# Behind Cloudflare's proxy (orange cloud), requests come from Cloudflare's addresses: take
# the visitor's address from CF-Connecting-IP, but only on requests from Cloudflare's own
# ranges. Without the proxy, this changes nothing. Refreshed on each run.
cf_ranges=$({ curl -fsSL -m 20 https://www.cloudflare.com/ips-v4; echo; curl -fsSL -m 20 https://www.cloudflare.com/ips-v6; } 2>/dev/null |
  grep -E '^[0-9a-fA-F:.]+/[0-9]{1,3}$' || true)
if [ -n "$cf_ranges" ]; then
  {
    echo "# Cloudflare's addresses (https://www.cloudflare.com/ips/), written by bin/install-server"
    for range in $cf_ranges; do echo "set_real_ip_from $range;"; done
    echo "real_ip_header CF-Connecting-IP;"
  } >/etc/nginx/conf.d/cloudflare-realip.conf
else
  echo "Could not download Cloudflare's address ranges: kept /etc/nginx/conf.d/cloudflare-realip.conf as it was"
fi
nginx -t && systemctl reload nginx

https=no
if [ -n "$email" ]; then
  say "HTTPS certificates (Let's Encrypt)"
  if certbot --nginx --redirect --non-interactive --agree-tos -m "$email" -d "$domain" -d "$ws_domain"; then
    https=yes
  else
    echo "certbot failed: check that $domain and $ws_domain point at this server, then run:"
    echo "  sudo certbot --nginx --redirect -d $domain -d $ws_domain"
  fi
fi

say "Firewall: SSH, HTTP and HTTPS only"
ufw allow OpenSSH >/dev/null
ufw allow 'Nginx Full' >/dev/null
ufw --force enable >/dev/null

cat <<EOF

GoGame is installed in $dir and runs as the $user user.
  systemctl status gogame gogame-ws        journalctl -u gogame -f
  HTTPS: $https   (without it, browsers can't open https://$domain yet)

Still to do (deploy/aws/README.md explains each):
  1. Email: put your SMTP settings (Amazon SES) in mailer.primary in $dir/conf/secrets.conf,
     set mock = false and security.email_confirm.enabled = true, then: sudo systemctl restart gogame
  2. Sign up on https://$domain, make that account an administrator:
       mongosh "mongodb://gogame:<password>@127.0.0.1/gogame?authSource=admin" \\
         --eval 'db.user4.updateOne({_id: "yourname"}, {\$set: {roles: ["ROLE_SUPER_ADMIN"]}})'
     and turn on two-factor authentication in its account security settings: in production,
     administrator roles only work with it.
  3. Back up $dir/conf/secrets.conf somewhere safe. Database backups run every night into
     /var/backups/gogame, each one checked by restoring it into a temporary database.
  4. Alerts and off-server copies, in /etc/gogame/backup.env (see deploy/aws/README.md):
     GOGAME_HEALTHCHECK_URL (an email when a backup fails or the disk fills up) and
     GOGAME_BACKUP_S3. Add an uptime monitor for https://$domain.
EOF
