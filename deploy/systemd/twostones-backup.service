# Nightly database backup (bin/backup-database). Installed by bin/install-server.
# Optional settings, in /etc/twostones/backup.env:
#   TWOSTONES_BACKUP_S3=s3://your-bucket/twostones        also copy each backup to S3
#   TWOSTONES_HEALTHCHECK_URL=https://hc-ping.com/...  get an email when a backup fails or is missed
[Unit]
Description=TwoStones database backup
After=mongod.service

[Service]
Type=oneshot
# the app user: never root, since the app user can write the project folder
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-/etc/twostones/backup.env
ExecStart=@DIR@/bin/backup-database
# Sandbox: the project folder is read-only for the running app, so a compromised app can't
# change the code, the scripts or these service templates.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadOnlyPaths=@DIR@
ReadWritePaths=/var/backups/twostones
